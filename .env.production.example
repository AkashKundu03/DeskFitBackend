# ── DeskFit backend — PRODUCTION (VPS, docker compose) ──
# On the server: copy to .env.production and fill in real values.
# NEVER commit .env.production (it is git-ignored).
#
# Key difference from local: inside docker compose the API reaches the database
# by the SERVICE NAME "postgres" (not localhost), on the internal network.

# Postgres credentials — used to initialize the postgres container.
POSTGRES_DB="deskfit"
POSTGRES_USER="deskfit_user"
POSTGRES_PASSWORD=""

# Connection string used by the API. Host MUST be "postgres" (the service name)
# and the user/password/db MUST match the three values above.
DATABASE_URL="postgresql://deskfit_user:CHANGE_ME@postgres:5432/deskfit?schema=public"

# JWT signing secret — generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=""

# Port the API listens on (also published by docker compose).
PORT=3000

# Apple Sign-In — audience must equal the iOS app bundle id.
APPLE_BUNDLE_ID="com.deskfitapp"
APPLE_CLIENT_ID="com.deskfitapp"

# Google Sign-In iOS OAuth client id (leave empty until configured).
GOOGLE_IOS_CLIENT_ID=""
