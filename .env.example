# ── DeskFit backend — LOCAL development ──
# Copy to .env and fill in. NEVER commit the real .env.

# Postgres connection string. For local dev (Postgres running on your machine):
DATABASE_URL="postgresql://deskfit_user:CHANGE_ME@localhost:5432/deskfit?schema=public"

# Postgres credentials (also used if you run Postgres via docker compose locally).
# These MUST match the user/password/db inside DATABASE_URL.
POSTGRES_DB="deskfit"
POSTGRES_USER="deskfit_user"
POSTGRES_PASSWORD=""

# JWT signing secret (use a long random value).
JWT_SECRET=""

# Port the API listens on.
PORT=3000

# Apple Sign-In — audience must equal the iOS app bundle id.
APPLE_BUNDLE_ID="com.deskfitapp"
APPLE_CLIENT_ID="com.deskfitapp"

# Google Sign-In iOS OAuth client id (leave empty until configured).
GOOGLE_IOS_CLIENT_ID=""

# ── Sign in with Apple: REVOCATION — OPTIONAL (not used by default) ──
# Account deletion uses a DATA WIPE (soft delete) that keeps the account shell,
# so NO Apple token revocation is performed and these are NOT required. Fill
# them only if you later switch to true hard-delete with token revocation.
# Source: developer.apple.com ▸ Certificates, Identifiers & Profiles ▸ Keys.
APPLE_TEAM_ID=""        # 10-char Team ID (developer.apple.com ▸ Membership details)
APPLE_KEY_ID=""         # 10-char Key ID shown next to the Sign in with Apple key
APPLE_PRIVATE_KEY=""    # .p8 file contents, on ONE line, real newlines escaped as \n
