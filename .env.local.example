# ── DeskFit backend — LOCAL development (.env.local) ──
# Copy this to .env.local and adjust if you like:
#     cp .env.local.example .env.local
#
# This file is LOCAL ONLY. It is loaded with HIGHER precedence than .env by both
# the API (NestJS ConfigModule) and Prisma. NEVER put production credentials here,
# and NEVER edit .env.production from local development.
#
# .env.local is git-ignored; .env.local.example (this template) is committed.

# Local Postgres credentials — used to initialize the local docker container
# (docker-compose.local.yml) AND referenced by DATABASE_URL below.
POSTGRES_DB="deskfit"
POSTGRES_USER="deskfit_user"
POSTGRES_PASSWORD="localdevpassword"

# The backend runs NATIVELY on your Mac (npm run start:dev), so it reaches the
# local docker Postgres over the published host port → host is "localhost".
# (In production the host is "postgres", the compose service name — different file.)
DATABASE_URL="postgresql://deskfit_user:localdevpassword@localhost:5432/deskfit?schema=public"

# JWT signing secret — any non-empty value is fine for local dev.
# Generate a stronger one if you want:  openssl rand -hex 32
JWT_SECRET="local-dev-jwt-secret-change-me"

# Port the API listens on.
PORT=3000

# Apple Sign-In — keep equal to the iOS bundle id so Apple login also works locally.
APPLE_BUNDLE_ID="com.deskfitapp"
APPLE_CLIENT_ID="com.deskfitapp"

# Google Sign-In iOS OAuth client id (leave empty until configured).
GOOGLE_IOS_CLIENT_ID=""
